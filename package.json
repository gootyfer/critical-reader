{
  "name": "critical-reader",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev:api": "pnpm --filter @critical-reader/api dev",
    "dev:extension": "pnpm --filter @critical-reader/extension dev",
    "build:extension": "pnpm --filter @critical-reader/extension build",
    "start:api": "pnpm --filter @critical-reader/api start",
    "eval:openai": "pnpm --filter @critical-reader/api eval:openai",
    "test": "pnpm -r test && node --test scripts/*.test.mjs",
    "render:extension-icons": "node scripts/render-extension-icons.mjs",
    "zip:extension": "pnpm --filter @critical-reader/extension exec wxt zip",
    "verify:extension-archive": "node scripts/verify-extension-archive.mjs",
    "typecheck": "pnpm -r typecheck"
  }
}
