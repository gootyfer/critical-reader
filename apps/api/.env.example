API_HOST=127.0.0.1
API_PORT=8787
ANALYZER=fake

# OpenAI analyzer (required only when ANALYZER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=30000

# Hosted beta policy (required when NODE_ENV=production)
NODE_ENV=development
ANALYSIS_ENABLED=true
ALLOWED_EXTENSION_ORIGINS=chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
CRITICAL_READER_CLIENT_VERSION=0.2.0
